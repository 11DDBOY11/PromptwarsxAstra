# Optional LLM: set your key to enable categorization/summary and action brief calls.
# Without a key the app runs entirely on the rule-based fallback.
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Alternatively, Anthropic:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-haiku-5-5

# FALLBACK_ONLY=1        # force the rule-based path even if a key is set
# EMBEDDER=st            # sentence-transformers (pip install sentence-transformers); default is tfidf
# ALLOW_DEMO_RESET=0     # disable the demo reset endpoint
